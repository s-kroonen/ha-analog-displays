# name: test_generated_yaml_matches_snapshot[with_buttons]
  '''
  # Generated by the Analog Displays integration for Home Assistant.
  #
  # This firmware exposes generic entities only. Which sensor feeds which meter,
  # how it is calibrated, and what the buttons do all live in Home Assistant and
  # can be changed there without reflashing.
  
  esphome:
    name: meter-panel
    friendly_name: Meter Panel
  
  esp32:
    board: esp32dev
    framework:
      type: esp-idf
  
  logger:
  
  api:
    encryption:
      key: !secret analog_displays_api_key
  
  ota:
    - platform: esphome
      password: !secret analog_displays_ota_password
  
  wifi:
    ssid: !secret wifi_ssid
    password: !secret wifi_password
    ap:
      ssid: "Meter Panel Fallback"
  
  captive_portal:
  
  output:
    - platform: ledc
      id: out_display_1
      pin: GPIO25
      frequency: 1000Hz
  
  number:
    - platform: template
      name: "Display 1"
      id: display_1
      min_value: 0
      max_value: 1
      step: 0.001
      optimistic: true
      set_action:
        - output.set_level:
            id: out_display_1
            level: !lambda return x;
  
  binary_sensor:
    - platform: gpio
      name: "Cycle"
      id: cycle
      pin:
        number: GPIO4
        mode:
          input: true
          pullup: true
        inverted: true
      on_multi_click:
        - timing:
            - ON for at most 0.4s
            - OFF for at least 0.35s
          then:
            - event.trigger:
                id: cycle_event
                event_type: single
        - timing:
            - ON for at most 0.4s
            - OFF for at most 0.3s
            - ON for at most 0.4s
            - OFF for at least 0.35s
          then:
            - event.trigger:
                id: cycle_event
                event_type: double
        - timing:
            - ON for at least 0.8s
          then:
            - event.trigger:
                id: cycle_event
                event_type: long
    - platform: gpio
      name: "Toggle"
      id: toggle
      pin:
        number: GPIO5
        mode:
          input: true
          pullup: true
        inverted: true
  
  event:
    - platform: template
      name: "Cycle clicks"
      id: cycle_event
      event_types:
        - single
        - double
        - long
  
  '''
